      ],
      "cssVars": {
        "theme": {
          "animate-parallax": "parallax linear both"
        }
      },
      "css": {
        "@keyframes parallax": {
          "from": {
            "transform": "translate3d(0, var(--parallax-offset, 0px), 0)"
          },
          "to": {
            "transform": "translate3d(0, calc(var(--parallax-offset, 0px) * -1), 0)"
          }
        }
      },
      "tailwind": {
        "config": {
          "theme": {
            "extend": {
              "keyframes": {
                "parallax": {
                  "from": {
                    "transform": "translate3d(0, var(--parallax-offset, 0px), 0)"
                  },
                  "to": {
                    "transform": "translate3d(0, calc(var(--parallax-offset, 0px) * -1), 0)"
                  }
                }
              },
              "animation": {
                "parallax": "parallax linear both"
              }
            }
          }
        }
      }

{
  "name": "corsair-native-dev",
  "private": true,
  "description": "Development harness for the React Native items in this folder: unit tests and type checks against Expo SDK 57, and a gallery app that shows every item. Nothing here is published to npm; the registry ships only the files each item lists.",
  "main": "gallery/index.ts",
  "scripts": {
    "start": "expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "preview:export": "expo export --platform web --output-dir ../../dist/registry/native-preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "expo": "57.0.26",
    "expo-haptics": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}

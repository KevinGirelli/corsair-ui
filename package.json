{
  "name": "corsair-ui",
  "version": "0.17.0",
  "private": true,
  "description": "Copy-and-own UI components, hooks and utilities, distributed as a shadcn-compatible registry.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "registry:validate": "shadcn registry validate ./registry.json",
    "registry:build": "shadcn build ./registry.json --output dist/registry/r",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:tailwind": "node scripts/check-tailwind-compat.ts",
    "verify:fixtures": "node scripts/verify-fixtures.ts",
    "native:install": "npm ci --prefix registry/native --no-audit --no-fund",
    "native:test": "npm test --prefix registry/native",
    "native:typecheck": "npm run typecheck --prefix registry/native",
    "registry:native:validate": "shadcn registry validate ./registry/native/registry.json",
    "registry:native:build": "shadcn build ./registry/native/registry.json --output dist/registry/r/native",
    "native:preview": "npm run preview:export --prefix registry/native",
    "verify:native": "node scripts/verify-native-fixtures.ts"
  },
  "devDependencies": {
    "@daypicker/react": "10.0.2",
    "@eslint/js": "9.39.5",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-table": "9.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/opentype.js": "1.3.10",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "input-otp": "1.5.0",
    "jsdom": "30.1.3",
    "lenis": "1.3.27",
    "lucide-react": "1.57.0",
    "opentype.js": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-resizable-panels": "4.14.5",
    "react-tweet": "3.3.1",
    "satori": "0.60.0",
    "shadcn": "4.21.5",
    "spotify-url-info": "3.3.3",
    "tailwind-merge": "3.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
